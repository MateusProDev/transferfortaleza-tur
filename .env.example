# Firebase web configuration (copy to .env.local for local development)
# Replace these placeholders with the values from your Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Ads / Conversion Tracking
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=11405399413
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=-lb-CLTxj_McEPWqwr4q
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_NAME="Lead WhatsApp - Passeios"
GOOGLE_ADS_CONVERSION_ID=11405399413
GOOGLE_ADS_CONVERSION_LABEL=-lb-CLTxj_McEPWqwr4q

# Firebase Admin (Backend Only; never use a web API key here)
# FIREBASE_ADMIN_SDK=...
FIREBASE_ADMIN_SDK_PATH=./firebase-adminsdk.json

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key
NEXT_PUBLIC_CLOUDINARY_API_SECRET=your_api_secret

# General Configuration
NEXT_PUBLIC_APP_NAME=Transfer Fortaleza Tur
NEXT_PUBLIC_APP_URL=https://transferfortalezatur.com.br
NODE_ENV=development
